{
  "framework": null,
  "installCommand": "npm install",
  "functions": {
    "api/protected-webgis.js": {
      "includeFiles": "{webgis,admin-users}.html"
    }
  },
  "rewrites": [
    { "source": "/webgis.html", "destination": "/api/protected-webgis" },
    { "source": "/admin-users.html", "destination": "/api/protected-webgis?page=admin-users" }
  ]
}
